{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marpelle.local/schemas/cli.schema.json",
  "title": "Marpelle CLI Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["prog", "description", "colors", "global_args", "commands"],
  "properties": {
    "prog": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "colors": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1},
      "required": ["title", "section", "command", "argument", "muted"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "section": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "argument": {"type": "string", "minLength": 1},
        "muted": {"type": "string", "minLength": 1}
      }
    },
    "global_args": {
      "type": "array",
      "items": {"$ref": "#/$defs/argSpec"}
    },
    "commands": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/commandSpec"}
    }
  },
  "$defs": {
    "argSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["help"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "short": {"type": "string", "pattern": "^-[A-Za-z0-9]$"},
        "long": {"type": "string", "pattern": "^--[A-Za-z0-9][A-Za-z0-9-]*$"},
        "help": {"type": "string"},
        "default": {}
      },
      "allOf": [
        {
          "anyOf": [
            {"required": ["name"]},
            {"required": ["long"]},
            {"required": ["short", "long"]}
          ]
        }
      ]
    },
    "commandSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["help", "args"],
      "properties": {
        "help": {"type": "string"},
        "args": {
          "type": "array",
          "items": {"$ref": "#/$defs/argSpec"}
        },
        "subcommands": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/commandSpec"}
        }
      }
    }
  }
}
